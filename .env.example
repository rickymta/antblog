# Cấu hình triển khai Docker (docker-compose.yml). Chép thành .env bằng:  sh deploy/init-env.sh
# (script tự sinh mọi mật khẩu/secret ngẫu nhiên; bạn chỉ cần điền các dòng ĐIỀN TAY).
# KHÔNG commit .env.

# --- Tên miền + chứng chỉ (ĐIỀN TAY) ---
# Tên miền trang đọc và trang quản trị — bản ghi DNS trên Cloudflare bật proxy (đám mây cam).
DOMAIN=antblog.xyz
ADMIN_DOMAIN=admin.antblog.xyz
# Thêm tên miền vào cùng chứng chỉ (cách nhau dấu phẩy), vd: www.antblog.xyz. Để trống nếu không cần.
CERT_EXTRA_DOMAINS=
# Email nhận thông báo hết hạn từ Let's Encrypt.
ACME_EMAIL=you@example.com
# API token Cloudflare, quyền: Zone › DNS › Edit, giới hạn đúng zone của DOMAIN.
# Để trống được khi domain chưa chuyển sang Cloudflare (certbot nằm chờ, nginx dùng chứng chỉ tự ký).
CF_API_TOKEN=
# 1 = thử với môi trường staging của Let's Encrypt (không dính giới hạn tần suất, chứng chỉ không được tin).
ACME_STAGING=0

# --- SEO ---
# true = chưa cho Google lập chỉ mục (robots.txt chặn hết, mọi trang noindex). Mặc định cho phép.
SITE_NOINDEX=false

# --- VPN vào database (ĐIỀN TAY) ---
# IP công khai của server, hoặc tên miền DNS-only (đám mây XÁM) trỏ về server, vd vpn.antblog.xyz.
WG_SERVER_URL=vpn.antblog.xyz
WG_PORT=51820
# Tên các máy khách VPN, cách nhau dấu phẩy (mỗi tên một file cấu hình). Chỉ chữ và số.
WG_PEERS=admin

# --- Thư mục mã nguồn API (mặc định ./api trong repo này) ---
API_DIR=./api

# --- Secret (init-env.sh tự sinh) ---
JWT_SECRET=
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=tkh_app
MONGO_APP_PASSWORD=
# Tài khoản CHỈ ĐỌC dùng khi kết nối qua VPN để kiểm tra dữ liệu.
MONGO_INSPECTOR_USERNAME=tkh_inspector
MONGO_INSPECTOR_PASSWORD=

# --- Tài khoản quản trị blog đầu tiên (docker compose run --rm seed) ---
SEED_ADMIN_EMAIL=admin@antblog.xyz
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Quản trị viên

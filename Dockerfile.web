# Trang đọc (apps/web, Next.js) — chạy bản standalone trên Node, cổng 3000. Build từ thư mục gốc repo.
# NEXT_PUBLIC_SITE_URL được nhúng vào bundle LÚC BUILD (canonical, Open Graph, JSON-LD) ⇒ truyền bằng build arg.

FROM node:22-alpine AS build
WORKDIR /repo
ENV NEXT_TELEMETRY_DISABLED=1 CI=1
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/admin/package.json apps/admin/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN --mount=type=cache,target=/root/.npm,sharing=locked npm ci
COPY packages ./packages
COPY apps/web ./apps/web
ARG NEXT_PUBLIC_SITE_URL=https://antblog.xyz
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
RUN npm run covers:check -w @tkh/web && npm run build -w @tkh/web

FROM node:22-alpine AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /app
# Bản standalone mang sẵn node_modules cần thiết + packages/* (outputFileTracingRoot = gốc repo).
COPY --from=build --chown=node:node /repo/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/web/.next/static ./apps/web/.next/static
# Next standalone excludes public assets; ship article covers alongside server.js.
COPY --from=build --chown=node:node /repo/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD wget -qO- http://127.0.0.1:3000/robots.txt >/dev/null || exit 1
CMD ["node", "apps/web/server.js"]

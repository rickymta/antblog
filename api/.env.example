NODE_ENV=development
# API chỉ nghe trên máy cục bộ
HOST=127.0.0.1
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/tech_knowledge_hub
# Chuỗi ngẫu nhiên ≥ 48 byte, ví dụ: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=change-me
SEED_ADMIN_EMAIL=admin@tkh.local
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Quản trị viên
# Cookie có cờ Secure (mặc định = NODE_ENV production). Chạy HTTP thuần thì đặt false.
COOKIE_SECURE=
# Express `trust proxy`: mặc định loopback (proxy Vite khi dev). Sau nginx trong Docker: subnet mạng compose.
TRUST_PROXY=
# Thư mục lưu ảnh của thư viện media (tương đối ⇒ tính từ thư mục api/). Mặc định ./uploads. Docker: volume `uploads`.
UPLOAD_DIR=

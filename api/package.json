{
  "name": "tech-blog-api",
  "version": "1.0.0",
  "private": true,
  "description": "API cho Tech Knowledge Hub (Express + MongoDB)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "seed": "tsx seed/run.ts",
    "seed:demo": "tsx seed/demo.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "gray-matter": "4.0.3",
    "helmet": "8.3.0",
    "image-size": "2.0.4",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.8",
    "multer": "2.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}

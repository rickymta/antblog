{
  "version": 1,
  "terms": [
    {
      "id": "in-depth-testing",
      "use": "kiểm thử chuyên sâu",
      "english": "in-depth testing",
      "note": "\"kiểm sâu\" là dịch từng chữ, người đọc không hiểu",
      "avoid": [
        {
          "text": "kiểm sâu",
          "severity": "high",
          "autofix": true
        }
      ]
    },
    {
      "id": "retirement",
      "use": "ngừng hỗ trợ",
      "english": "retirement (dịch vụ, SKU)",
      "note": "\"nghỉ hưu\" là calque của retire; dùng \"ngừng hỗ trợ\" hoặc \"khai tử\"",
      "avoid": [
        {
          "text": "nghỉ hưu",
          "severity": "medium"
        }
      ]
    },
    {
      "id": "reporting-period-boundary",
      "use": "ranh giới kỳ báo cáo",
      "english": "period boundary",
      "note": "\"biên kỳ\" là từ tự ghép",
      "avoid": [
        {
          "text": "biên kỳ",
          "severity": "high",
          "autofix": true
        }
      ]
    },
    {
      "id": "downgrade",
      "use": "hạ phiên bản",
      "english": "downgrade / rollback trên thiết bị",
      "avoid": [
        {
          "text": "hạ máy",
          "severity": "high"
        }
      ]
    },
    {
      "id": "deduplication",
      "use": "khử trùng lặp",
      "english": "deduplication",
      "glossary": true,
      "definition": "Loại bỏ các bản ghi hoặc thông điệp bị lặp, thường dựa vào một khoá định danh như mã giao dịch hay mã sự kiện.",
      "note": "\"khử trùng\" nghĩa là diệt khuẩn — sai nghĩa",
      "avoid": [
        {
          "text": "khử trùng",
          "severity": "high",
          "notFollowedBy": "lặp",
          "autofix": true
        }
      ]
    },
    {
      "id": "source-of-truth",
      "use": "nguồn dữ liệu gốc",
      "english": "source of truth",
      "glossary": true,
      "definition": "Nơi lưu bản dữ liệu được coi là đúng và có thẩm quyền; mọi bản sao khác (cache, báo cáo) phải đồng bộ theo nó.",
      "note": "\"nguồn sự thật\" là calque; có thể giữ \"source of truth\" kèm giải nghĩa lần đầu",
      "avoid": [
        {
          "text": "nguồn sự thật",
          "severity": "medium"
        }
      ]
    },
    {
      "id": "circuit-breaker",
      "use": "circuit breaker",
      "keepEnglish": true,
      "glossary": true,
      "definition": "Cơ chế tạm ngừng gọi một dịch vụ đang lỗi liên tục, để hệ thống không bị kéo sập theo và dịch vụ kia có thời gian phục hồi.",
      "avoid": [
        {
          "text": "cầu dao",
          "severity": "low"
        }
      ]
    },
    {
      "id": "smoke-test",
      "use": "smoke test",
      "keepEnglish": true,
      "glossary": true,
      "definition": "Bộ kiểm thử nhỏ, chạy nhanh trên các luồng sống còn để quyết định một bản build có đủ ổn định để kiểm thử chuyên sâu hay không."
    },
    {
      "id": "sanity-test",
      "use": "sanity test",
      "keepEnglish": true,
      "glossary": true,
      "definition": "Lượt kiểm thử hẹp, tập trung vào một thay đổi vừa sửa, để xác nhận thay đổi đó hợp lý trước khi đưa vào các vòng kiểm thử lớn hơn."
    },
    {
      "id": "regression-test",
      "use": "regression test",
      "keepEnglish": true,
      "glossary": true,
      "definition": "Kiểm thử lại các chức năng đã chạy đúng, để phát hiện lỗi mới phát sinh do một thay đổi ở chỗ khác."
    },
    {
      "id": "test-case",
      "use": "test case",
      "keepEnglish": true,
      "glossary": true,
      "definition": "Một tình huống kiểm thử cụ thể gồm điều kiện đầu, dữ liệu vào, các bước thực hiện và kết quả mong đợi."
    }
  ],

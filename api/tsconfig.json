{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "node"
    ]
  },
  // glossary-render.test.ts render ArticleContent của packages/ui (mã frontend, phân giải module kiểu bundler):
  // gói ui/shared tự typecheck riêng; vitest vẫn chạy tệp test này.
  "exclude": ["test/glossary-render.test.ts"],
  "include": [
    "src",
    "seed/**/*.ts",
    "test",
    "vitest.config.ts",
    "scripts/**/*.ts"
  ]
}

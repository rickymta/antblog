# dbank.${DOMAIN}: proxy tới container mdt-dbank (dự án riêng, cùng mạng Docker).
# Dùng chung chứng chỉ của stack — PHẢI có `dbank.<DOMAIN>` trong CERT_EXTRA_DOMAINS của .env.
server {
    listen 80;
    server_name dbank.${DOMAIN};
    return 301 https://dbank.${DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    # Match antblog virtual hosts when browsers reuse an HTTP/2 TLS connection.
    http2 on;
    server_name dbank.${DOMAIN};

    include /etc/nginx/tkh-ssl.conf;
    add_header X-Robots-Tag "noindex, nofollow" always;

    location / {
        # Docker DNS keeps the route valid when the bank container is recreated.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $dbank_backend http://mdt-dbank:3000;
        proxy_pass $dbank_backend;
        proxy_http_version 1.1;

        # Overwrite these headers: Express trusts exactly one reverse proxy.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_cache off;
    }
}

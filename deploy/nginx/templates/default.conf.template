# Cổng vào duy nhất của stack. Ảnh nginx chính thức thay ${DOMAIN} và ${ADMIN_DOMAIN} lúc khởi động
# (envsubst chỉ thay biến môi trường có thật, nên các biến nginx như $host, $remote_addr giữ nguyên).
#
#   :80                     → /healthz cho healthcheck, mọi thứ khác chuyển hướng sang HTTPS
#   :443 ${DOMAIN}          → trang đọc: proxy tới container `web` (Next.js, render phía server cho SEO)
#   :443 ${ADMIN_DOMAIN}    → trang quản trị: tệp tĩnh (React SPA), luôn noindex
#   cả hai tên miền         → /api/ proxy tới API, /uploads/ đọc thẳng volume ảnh
#   :443 host lạ / gọi IP   → đóng kết nối (444)
#
# /api/ ở cả hai tên miền đều đi tới cùng API ⇒ cookie đăng nhập cùng origin với từng trang, không cần CORS.
# Cookie gắn theo host nên phiên của trang đọc và trang quản trị tách riêng.
#
# Đứng sau Cloudflare: chế độ SSL của Cloudflare PHẢI là "Full (strict)". Để "Flexible" thì Cloudflare gọi
# vào port 80, port 80 lại chuyển hướng sang HTTPS ⇒ vòng lặp chuyển hướng.

upstream tkh_api {
  server api:4000;
  keepalive 16;
}

upstream tkh_web {
  server web:3000;
  keepalive 16;
}

# Micro-cache HTML của trang đọc: mỗi trang chỉ render lại tối đa 1 lần / 60 giây dù bao nhiêu người đọc
# (TTFB thấp, chịu được lượt truy cập dồn dập). An toàn vì HTML trang đọc giống hệt nhau với mọi người:
# không đọc cookie khi render, trạng thái đăng nhập/reaction/bình luận tải phía trình duyệt qua /api/.
# Không cache: request RSC của bộ định tuyến Next.js (header `RSC`, nội dung khác HTML) và request có cookie
# phiên (phòng khi sau này có trang render theo người dùng). Phản hồi có Set-Cookie nginx tự không cache.
proxy_cache_path /var/cache/nginx/tkh_web levels=1:2 keys_zone=tkh_web:10m max_size=256m inactive=30m use_temp_path=off;

map "$http_rsc$http_next_router_prefetch$cookie_tkh_session" $tkh_web_nocache {
  ""      0;
  default 1;
}

# Cache-Control gửi cho trình duyệt/Cloudflare thay cho của Next.js (trang render động gửi `no-store`, chặn
# back/forward cache của trình duyệt). `no-cache` = luôn hỏi lại nhưng vẫn được giữ trong bfcache.
map $tkh_web_nocache $tkh_web_cache_control {
  0       "public, max-age=0, must-revalidate";
  default "private, no-cache";
}

# Giới hạn thô tầng nginx theo IP thật (sau real_ip của Cloudflare). API có rate limit riêng cho đăng nhập/bình luận.
limit_req_zone $binary_remote_addr zone=tkh_api:10m rate=20r/s;

ssl_protocols TLSv1.2 TLSv1.3;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:tkh_ssl:10m;
ssl_session_timeout 1d;

server {
  listen 80 default_server;
  server_name _;
  server_tokens off;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# Host không thuộc hai tên miền (quét IP, tên miền lạ trỏ nhầm) ⇒ đóng kết nối, không lộ nội dung.
server {
  listen 443 ssl default_server;
  http2 on;
  server_name _;
  server_tokens off;
  # Đường dẫn chứng chỉ do /usr/local/bin/tkh-select-cert.sh ghi: Let's Encrypt nếu đã có, không thì
  # chứng chỉ tự ký tạm (để nginx vẫn khởi động được trong lúc certbot đang xin chứng chỉ thật).
  include /etc/nginx/tkh-ssl.conf;
  return 444;
}

# Trang đọc — Next.js. Không gắn X-Robots-Tag: robots do Next.js quản lý (metadata từng trang + /robots.txt,
# biến SITE_NOINDEX của container `web`).
server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};
  server_tokens off;
  include /etc/nginx/tkh-ssl.conf;
  include /etc/nginx/snippets/tkh-site-common.conf;
  include /etc/nginx/snippets/tkh-headers.conf;

  location / {
    proxy_pass http://tkh_web;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    # Next.js đã tự gửi các header bảo mật này — bỏ bản của upstream để không bị trùng với bản của nginx.
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header X-Frame-Options;
    proxy_read_timeout 60s;

    proxy_cache tkh_web;
    proxy_cache_key "$scheme$host$request_uri";
    proxy_cache_bypass $tkh_web_nocache;
    proxy_no_cache $tkh_web_nocache;
    # Next.js gửi `private, no-store` cho trang render động ⇒ bỏ qua để micro-cache vẫn chạy.
    proxy_ignore_headers Cache-Control Expires;
    proxy_cache_valid 200 301 308 60s;
    proxy_cache_valid 404 10s;
    # Hết hạn ⇒ trả bản cũ ngay và làm mới ở nền; web lỗi/đang khởi động lại ⇒ vẫn trả bản cũ.
    proxy_cache_use_stale updating error timeout http_500 http_502 http_503 http_504;
    proxy_cache_background_update on;
    proxy_cache_lock on;
    proxy_cache_lock_timeout 5s;

    proxy_hide_header Cache-Control;
    add_header Cache-Control $tkh_web_cache_control always;
    add_header X-Cache-Status $upstream_cache_status always;
    # location có add_header riêng ⇒ không kế thừa header của server, phải include lại.
    include /etc/nginx/snippets/tkh-headers.conf;
  }

  # Tệp tĩnh của Next.js có hash trong tên ⇒ cache lâu ở nginx (Next.js đã gửi `immutable`).
  location /_next/static/ {
    proxy_pass http://tkh_web;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header X-Frame-Options;
    proxy_cache tkh_web;
    proxy_cache_key "$scheme$host$request_uri";
    proxy_cache_valid 200 7d;
    proxy_cache_lock on;
  }
}

# Trang quản trị — tệp tĩnh, luôn noindex.
server {
  listen 443 ssl;
  http2 on;
  server_name ${ADMIN_DOMAIN};
  server_tokens off;
  include /etc/nginx/tkh-ssl.conf;
  include /etc/nginx/snippets/tkh-site-common.conf;
  include /etc/nginx/snippets/tkh-headers.conf;
  include /etc/nginx/snippets/tkh-noindex.conf;

  root /usr/share/nginx/html/admin;

  # Tệp tĩnh có hash trong tên ⇒ cache lâu.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable" always;
    include /etc/nginx/snippets/tkh-headers.conf;
    include /etc/nginx/snippets/tkh-noindex.conf;
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache" always;
    include /etc/nginx/snippets/tkh-headers.conf;
    include /etc/nginx/snippets/tkh-noindex.conf;
  }
}

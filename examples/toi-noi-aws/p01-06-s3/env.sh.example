# Sao chép thành env.sh rồi sửa. env.sh không chứa secret, nhưng đừng commit giá trị tài khoản thật.
export AWS_REGION="ap-southeast-1"
# Profile SSO tạo ở bài 02. Để trống nếu bạn đã export credential bằng cách khác.
export AWS_PROFILE="toinoi-lab"
# Tên bucket phải duy nhất toàn cầu. Mặc định thêm account ID thật (lấy từ sts) phía sau.
# export BUCKET="toinoi-lab-delivery-photos-<đổi-thành-chuỗi-duy-nhất>"
# Origin của web Tới Nơi được phép PUT/GET trực tiếp bằng presigned URL (CORS).
export WEB_ORIGIN="https://app.toinoi.example"
# Tuỳ chọn: ARN role toinoi-lab-delivery-photo của service delivery-photo (tạo ở bài 03), ví dụ arn:aws:iam::123456789012:role/toinoi-lab-delivery-photo. Để trống thì policy chỉ có phần chặn HTTP không mã hoá.
export APP_ROLE_ARN=""

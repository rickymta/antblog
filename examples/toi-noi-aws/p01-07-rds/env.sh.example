# Sao chép thành env.sh rồi sửa. Các ID dưới đây là ví dụ, thay bằng ID trong tài khoản lab của bạn.
export AWS_REGION="ap-southeast-1"
export AWS_PROFILE="toinoi-lab"

# Từ lab bài 04 (VPC). ĐỂ TRỐNG = tự tra theo tag Name của bài 04: VPC toinoi-lab-vpc,
# hai subnet private-data toinoi-lab-data-a/-b (hai AZ) và security group toinoi-lab-app.
# Chỉ điền ID (ví dụ "vpc-0123456789abcdef0") khi bạn dựng mạng theo cách khác.
export VPC_ID=""
export DB_SUBNET_IDS=""      # hai ID cách nhau bằng dấu cách
export SG_APP_ID=""

# Role của instance EC2 ở bài 05 (create-instance.sh --use-lab-vpc tạo role toinoi-lab-quote-ec2),
# để cấp quyền đọc secret của DB. Để trống thì bỏ qua bước đó.
export EC2_ROLE_NAME="toinoi-lab-quote-ec2"

# Phiên bản engine: để trống = phiên bản mặc định của RDS. Muốn ghim, đặt đúng một phiên bản có trong:
#   aws rds describe-db-engine-versions --engine postgres --query 'DBEngineVersions[].[EngineVersion,DBParameterGroupFamily]' --output text
export PG_ENGINE_VERSION=""
# Family của parameter group (ví dụ postgres17) phải khớp phiên bản engine.
# Để trống = 01-create-db.sh tự tra family của phiên bản ở trên (hoặc của phiên bản mặc định).
export PG_FAMILY=""
export DB_INSTANCE_CLASS="db.t4g.micro"

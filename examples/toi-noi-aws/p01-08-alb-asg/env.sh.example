# Sao chép thành env.sh rồi sửa. Các ID là ví dụ, thay bằng ID trong tài khoản lab của bạn.
export AWS_REGION="ap-southeast-1"
export AWS_PROFILE="toinoi-lab"

# Từ lab bài 04 (VPC). ĐỂ TRỐNG = tự tra theo tag Name của bài 04: VPC toinoi-lab-vpc,
# subnet public toinoi-lab-public-a/-b (cho ALB) và private-app toinoi-lab-app-a/-b (cho instance).
# Instance ở private-app cần đường ra Internet/SSM: dựng bài 04 với --with-nat.
# Chỉ điền ID (ví dụ "vpc-0123456789abcdef0") khi bạn dựng mạng theo cách khác.
export VPC_ID=""
export PUBLIC_SUBNET_IDS=""   # hai ID cách nhau bằng dấu cách, ở hai AZ khác nhau
export APP_SUBNET_IDS=""

# Instance profile có quyền Session Manager (AmazonSSMManagedInstanceCore), do lab bài 05 tạo.
# Đừng chạy cleanup.sh của bài 05 trước khi xong bài 08 và bài 10.
export INSTANCE_PROFILE_NAME="toinoi-lab-quote-ec2"
# Để trống = lấy AMI Amazon Linux 2023 mới nhất từ public SSM parameter của AWS.
export AMI_ID=""
export INSTANCE_TYPE="t3.micro"

# Chỉ IP này được gọi ALB (cổng 80). Để trống = tự lấy IP hiện tại của bạn bằng checkip.amazonaws.com.
export ALB_INGRESS_CIDR=""

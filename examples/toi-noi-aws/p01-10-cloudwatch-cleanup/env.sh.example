# Sao chép thành env.sh rồi sửa.
export AWS_REGION="ap-southeast-1"
export AWS_PROFILE="toinoi-lab"

# Email nhận cảnh báo (SNS gửi thư xác nhận, phải bấm Confirm mới nhận được). Dùng email của bạn, không commit.
export ALERT_EMAIL="ban-sua-dia-chi@example.com"
# Hạn mức ngân sách tháng (USD) do BẠN chọn theo mức chấp nhận được cho tài khoản lab.
export BUDGET_AMOUNT_USD="20"
# Role của instance EC2 (bài 05 tạo, bài 08 dùng lại qua instance profile cùng tên) để gắn quyền gửi
# log/metric của CloudWatch agent. Để trống thì bỏ qua.
export EC2_ROLE_NAME="toinoi-lab-quote-ec2"

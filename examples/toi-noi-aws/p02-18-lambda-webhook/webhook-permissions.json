{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendPaymentEvents",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "${QUEUE_ARN}"
    },
    {
      "Sid": "ReadWebhookSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "${SECRET_ARN}"
    }
  ]
}

{
  "index_patterns": [
    "toinoi-logs-*"
  ],
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 1,
        "number_of_replicas": 1
      }
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "service": {
          "type": "keyword"
        },
        "level": {
          "type": "keyword"
        },
        "trace_id": {
          "type": "keyword"
        },
        "message": {
          "type": "text"
        }
      }
    }
  }
}

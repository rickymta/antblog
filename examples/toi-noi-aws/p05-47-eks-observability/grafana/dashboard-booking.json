{
  "title": "Tới Nơi - booking",
  "uid": "toinoi-booking",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["toinoi", "booking"],
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "p95 latency của booking (giây)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_AMP}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{namespace=\"booking\"}[5m])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tỷ lệ 5xx của booking",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_AMP}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{namespace=\"booking\", http_response_status_code=~\"5..\"}[5m])) / sum(rate(http_server_request_duration_seconds_count{namespace=\"booking\"}[5m]))"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      { "name": "DS_AMP", "type": "datasource", "query": "prometheus", "label": "Amazon Managed Prometheus" }
    ]
  }
}

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SameTeamFunctionsOnly",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction",
        "lambda:GetFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:toinoi-*",
      "Condition": {
        "StringEquals": { "aws:ResourceTag/Team": "${aws:PrincipalTag/Team}" }
      }
    },
    {
      "Sid": "CreateFunctionWithOwnTeamTag",
      "Effect": "Allow",
      "Action": "lambda:CreateFunction",
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:toinoi-*",
      "Condition": {
        "StringEquals": { "aws:RequestTag/Team": "${aws:PrincipalTag/Team}" }
      }
    },
    {
      "Sid": "TagOwnTeamFunctionsOnly",
      "Effect": "Allow",
      "Action": "lambda:TagResource",
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:toinoi-*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Team": "${aws:PrincipalTag/Team}",
          "aws:RequestTag/Team": "${aws:PrincipalTag/Team}"
        }
      }
    },
    {
      "Sid": "OnlyPlatformAdminMayRemoveTeamTag",
      "Effect": "Deny",
      "Action": "lambda:UntagResource",
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEquals": { "aws:TagKeys": ["Team"] },
        "StringNotEquals": { "aws:PrincipalTag/Role": "platform-admin" }
      }
    }
  ]
}

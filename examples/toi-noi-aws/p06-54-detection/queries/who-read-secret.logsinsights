# CloudWatch Logs Insights trên log group của trail (/toinoi/<env>/cloudtrail):
# ai đọc secret của VíXanh trong khoảng thời gian bạn chọn khi chạy (ví dụ 7 ngày)?
fields @timestamp, userIdentity.arn, sourceIPAddress, userAgent, errorCode
| filter eventSource = "secretsmanager.amazonaws.com" and eventName = "GetSecretValue"
| filter requestParameters.secretId like /toinoi\/prod\/vixanh/
| sort @timestamp desc
| limit 200

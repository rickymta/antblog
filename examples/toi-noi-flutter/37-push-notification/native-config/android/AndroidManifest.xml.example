<!-- Phần cấu hình push của android/app/src/main/AndroidManifest.xml.
     Các phần còn lại (activity, intent-filter...) giữ nguyên từ template Flutter. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13 (API 33) trở lên. SDK FCM và plugin đã tự khai quyền này,
         ta khai tường minh cho rõ; quyền vẫn phải được xin lúc chạy. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="Toi Noi"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!-- Bật định danh đăng ký kiểu FID (register/onRegistered). -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true"/>

        <!-- Kênh FCM dùng khi tin không nói rõ kênh. Phải trùng
             tripUpdatesChannelId trong lib/notification_channel.dart. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="trip_updates"/>
    </application>
</manifest>

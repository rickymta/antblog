# Mẫu biến môi trường cho fastlane của Tới Nơi. Mọi giá trị để TRỐNG.
# Máy cá nhân: chép thành ios/.env và android/.env (fastlane chỉ tìm .env trong
# thư mục fastlane/ và thư mục cha của nó). Thêm các dòng trong
# gitignore.fragment.example vào ios/.gitignore và android/.gitignore trước khi điền.
# CI: đặt các biến này trong kho secret của nhà cung cấp CI (bài 54), không tạo file.

# --- iOS: App Store Connect API key (thay cho Apple ID và mật khẩu) ---
# Key ID của API key tạo ở App Store Connect.
ASC_KEY_ID=
# Issuer ID hiện ở trang Integrations của App Store Connect.
ASC_ISSUER_ID=
# Nội dung file .p8 mã hoá base64 một dòng. macOS: base64 -i AuthKey_XXXX.p8
# Linux (GNU coreutils): base64 -w0 AuthKey_XXXX.p8
ASC_KEY_CONTENT=

# --- iOS: match ---
# URL repo riêng (private) chứa chứng chỉ và provisioning profile đã mã hoá.
MATCH_GIT_URL=
# Mật khẩu giải mã nội dung repo match. Mất mật khẩu này là mất kho chứng chỉ.
MATCH_PASSWORD=
# Xác thực vào repo match trên CI (một trong hai; để trống nếu dùng SSH sẵn có):
# HTTPS: base64 của "tên_đăng_nhập:personal_access_token" (echo -n ... | base64).
MATCH_GIT_BASIC_AUTHORIZATION=
# Deploy key SSH của repo match.
MATCH_GIT_PRIVATE_KEY=
# Team ID của Apple Developer Program (đọc bởi Appfile).
APPLE_TEAM_ID=

# --- Android: Google Play ---
# Nội dung JSON của service account có quyền phát hành, dán nguyên văn.
PLAY_JSON_KEY_DATA=

# Lane bổ sung cho Fastfile iOS của bài 53. Đặt thành ios/fastlane/BetaExternal.fastfile
# rồi thêm dòng sau lên đầu ios/fastlane/Fastfile của lab 53, phía trên các lane:
#
#   import "BetaExternal.fastfile"
#
# Không dán thẳng vào Fastfile của lab 53: audit của lab đó cấm distribute_external
# trong file ấy. File này dùng lại env!, pick_target và asc_api_key đã định nghĩa
# ở đó (Ruby chỉ tìm chúng lúc lane chạy). Đường dẫn tương đối của import chưa kiểm.
#
# Biến môi trường cần thêm vào ios/.env hoặc kho secret của CI, ngoài các biến của bài 53
# (lab 53 không có sẵn; mọi giá trị là thông tin của bạn, không commit):
#   BETA_APP_DESCRIPTION  BETA_APP_FEEDBACK_EMAIL
#   BETA_REVIEW_CONTACT_EMAIL  BETA_REVIEW_CONTACT_FIRST_NAME
#   BETA_REVIEW_CONTACT_LAST_NAME  BETA_REVIEW_CONTACT_PHONE
#   BETA_DEMO_ACCOUNT  BETA_DEMO_PASSWORD
#
#   bundle exec fastlane ios beta_external app:driver flavor:staging \
#     ipa:../build/ios/fastlane/Runner.ipa group:"Tài xế thử nghiệm" \
#     changelog_file:../whats-new.txt
#
# CHƯA chạy thật: repository không có tài khoản Apple Developer.

platform :ios do
  desc "Tải IPA lên TestFlight, gán cho một nhóm external và gửi Beta App Review."
  lane :beta_external do |options|
    _flavor, bundle_id = pick_target(options)

    ipa = options[:ipa].to_s
    UI.user_error!("Cần ipa:<đường dẫn tới file .ipa>") if ipa.empty?
    group = options[:group].to_s
    UI.user_error!("Cần group:<tên nhóm external>") if group.empty?
    changelog_file = options[:changelog_file].to_s
    UI.user_error!("Cần changelog_file:<file What to Test>") if changelog_file.empty?
    UI.user_error!("Không thấy #{changelog_file}") unless File.exist?(changelog_file)

    # Đọc biến trước khi tải lên: thiếu biến thì dừng sau vài giây.
    beta_description = env!("BETA_APP_DESCRIPTION")
    feedback_email = env!("BETA_APP_FEEDBACK_EMAIL")
    review_info = {
      contact_email: env!("BETA_REVIEW_CONTACT_EMAIL"),
      contact_first_name: env!("BETA_REVIEW_CONTACT_FIRST_NAME"),
      contact_last_name: env!("BETA_REVIEW_CONTACT_LAST_NAME"),
      contact_phone: env!("BETA_REVIEW_CONTACT_PHONE"),
      demo_account_name: env!("BETA_DEMO_ACCOUNT"),
      demo_account_password: env!("BETA_DEMO_PASSWORD"),
      notes: "Đăng nhập bằng tài khoản demo. Tài khoản không hết hạn.",
    }

    # Không đặt skip_waiting_for_build_processing: với true, pilot không phân
    # phối được cho nhóm external (docs.fastlane.tools).
    # Không đặt uses_non_exempt_encryption: Info.plist đã có
    # ITSAppUsesNonExemptEncryption.
    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: bundle_id,
      ipa: ipa,
      changelog: File.read(changelog_file),
      beta_app_description: beta_description,
      beta_app_feedback_email: feedback_email,
      distribute_external: true,
      groups: [group],
      notify_external_testers: true,
      demo_account_required: true,
      beta_app_review_info: review_info,
    )
  end
end

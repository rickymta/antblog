<plist version="1.0">
<dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Tới Nơi dùng vị trí của bạn khi đang mở app để biết bạn đang online ở đâu và gợi ý cuốc gần nhất.</string>

{
  "name": "toi-noi-git-lab",
  "private": true,
  "type": "module",
  "description": "Lab Git qua GitStudio và Tới Nơi — runner Node không có dependency, git chạy với cấu hình cô lập để mã hash commit tái lập được",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "p01": "node run.mjs p01",
    "p01:output": "node run.mjs p01 > p01/OUTPUT.txt",
    "setup": "node run.mjs setup",
    "kiem-tra": "node p01/kiem-tra.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "p02": "node run.mjs p02",
    "p02:output": "node run.mjs p02 > p02/OUTPUT.txt",
    "kiem-tra-p02": "node p02/kiem-tra.mjs",
    "p03": "node run.mjs p03",
    "p03:output": "node run.mjs p03 > p03/OUTPUT.txt",
    "kiem-tra-p03": "node p03/kiem-tra.mjs",
    "p04": "node run.mjs p04",
    "p04:output": "node run.mjs p04 > p04/OUTPUT.txt",
    "kiem-tra-p04": "node p04/kiem-tra.mjs"
  }
}

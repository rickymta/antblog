#!/usr/bin/python3
# bao-gia 1.5.0: dịch vụ báo giá của Tới Nơi (bản của lab, chỉ dùng thư viện chuẩn của Python).
#
#   GET /suc-khoe                        -> {"trang_thai": "ok", ...}
#   GET /bao-gia?dich_vu=car4&km=12.5    -> {"dich_vu": "car4", "km": 12.5, "gia": 69000}
#
# Cấu hình bằng biến môi trường (systemd đọc từ EnvironmentFile=):
#   BAO_GIA_CONG        cổng lắng nghe (mặc định 8080)
#   BAO_GIA_MOI_TRUONG  production / staging
#   BAO_GIA_BANG_GIA    file bảng giá CSV
#   BAO_GIA_LOG         file log yêu cầu (mỗi yêu cầu một dòng)
#   BANDO_API_KEY       khoá dịch vụ bản đồ (bí mật, chỉ kiểm tra là có)
#
# Log vòng đời và lỗi in ra stdout/stderr, có tiền tố mức <N> để journald hiểu mức ưu tiên.
# Tín hiệu: SIGTERM dừng gọn; SIGHUP mở lại file log (sau logrotate) và nạp lại bảng giá.
import csv
import json
import math
import os
import signal
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

PHIEN_BAN = '1.5.0'
CONG = int(os.environ.get('BAO_GIA_CONG', '8080'))
MOI_TRUONG = os.environ.get('BAO_GIA_MOI_TRUONG', 'production')
BANG_GIA = os.environ.get('BAO_GIA_BANG_GIA', 'bang-gia.csv')
FILE_LOG = os.environ.get('BAO_GIA_LOG', '')


def ghi(muc, noi_dung):
    """In một dòng log cho journald: <6> INFO, <4> WARNING, <3> ERROR."""
    so = {'INFO': 6, 'WARN': 4, 'LOI': 3}[muc]
    print(f'<{so}>{muc:<4} {noi_dung}', flush=True)


def nap_bang_gia(duong_dan):
    with open(duong_dan, newline='', encoding='utf-8') as f:
        return {d['dich_vu']: d for d in csv.DictReader(f)}


class TrangThai:
    def __init__(self):
        self.khoa = threading.Lock()
        self.bang = {}
        self.log = None
        self.so_yeu_cau = 100000

    def mo_log(self):
        if not FILE_LOG:
            return
        with self.khoa:
            if self.log:
                self.log.close()
            self.log = open(FILE_LOG, 'a', encoding='utf-8')

    def ghi_yeu_cau(self, dong):
        with self.khoa:
            self.so_yeu_cau += 1
            ma = f'q-{self.so_yeu_cau}'
            if self.log:
                gio = time.strftime('%Y-%m-%d %H:%M:%S')
                self.log.write(f'{gio} INFO  {ma} {dong}\n')
                self.log.flush()
            return ma


tt = TrangThai()


class XuLy(BaseHTTPRequestHandler):
    server_version = f'bao-gia/{PHIEN_BAN}'

    def tra_loi(self, ma, du_lieu):
        than = (json.dumps(du_lieu, ensure_ascii=False) + '\n').encode()
        self.send_response(ma)
        self.send_header('Content-Type', 'application/json; charset=utf-8')
        self.send_header('Content-Length', str(len(than)))
        self.end_headers()
        self.wfile.write(than)

    def do_GET(self):
        url = urlparse(self.path)
        if url.path == '/suc-khoe':
            return self.tra_loi(200, {'trang_thai': 'ok', 'phien_ban': PHIEN_BAN, 'pid': os.getpid(),
                                      'moi_truong': MOI_TRUONG, 'so_dich_vu': len(tt.bang)})
        if url.path == '/bao-gia':
            q = parse_qs(url.query)
            dv = q.get('dich_vu', [''])[0]
            try:
                km = float(q.get('km', ['0'])[0])
            except ValueError:
                km = -1
            bat_dau = time.monotonic()
            d = tt.bang.get(dv)
            if d is None or km <= 0:
                ghi('WARN', f'yeu cau khong hop le: dich_vu={dv or "-"} km={q.get("km", ["-"])[0]}')
                return self.tra_loi(400, {'loi': 'dich_vu hoac km khong hop le'})
            gia = max(int(d['gia_mo_cua']) + km * int(d['gia_moi_km']), int(d['gia_toi_thieu']))
            gia = int(math.ceil(gia / 1000) * 1000)
            ms = int((time.monotonic() - bat_dau) * 1000)
            tt.ghi_yeu_cau(f'dich_vu={dv} km={km:g} gia={gia} {ms} ms')
            return self.tra_loi(200, {'dich_vu': dv, 'km': km, 'gia': gia})
        return self.tra_loi(404, {'loi': 'khong tim thay'})

    def log_message(self, *args):
        pass  # mỗi yêu cầu đã ghi vào file log riêng


def main():
    if not os.environ.get('BANDO_API_KEY'):
        ghi('LOI', 'thieu bien BANDO_API_KEY, dung lai')
        sys.exit(2)
    try:
        tt.bang = nap_bang_gia(BANG_GIA)
    except OSError as e:
        ghi('LOI', f'khong doc duoc bang gia {BANG_GIA}: {e.strerror}')
        sys.exit(1)
    tt.mo_log()
    may_chu = ThreadingHTTPServer(('127.0.0.1', CONG), XuLy)

    def khi_term(so, _):
        ghi('INFO', f'nhan {signal.Signals(so).name}, ngung nhan yeu cau moi va dung')
        threading.Thread(target=may_chu.shutdown).start()

    def khi_hup(so, _):
        tt.mo_log()
        try:
            tt.bang = nap_bang_gia(BANG_GIA)
            ghi('INFO', f'nhan SIGHUP: mo lai file log, nap lai bang gia ({len(tt.bang)} loai dich vu)')
        except OSError as e:
            ghi('LOI', f'nhan SIGHUP: khong doc duoc bang gia {BANG_GIA}: {e.strerror}; giu bang gia cu')

    signal.signal(signal.SIGTERM, khi_term)
    signal.signal(signal.SIGINT, khi_term)
    signal.signal(signal.SIGHUP, khi_hup)
    ghi('INFO', f'bao-gia {PHIEN_BAN} khoi dong, pid {os.getpid()}, cong {CONG}, moi truong {MOI_TRUONG}')
    ghi('INFO', f'nap bang gia: {len(tt.bang)} loai dich vu tu {BANG_GIA}')
    may_chu.serve_forever()
    ghi('INFO', 'da dung')


if __name__ == '__main__':
    main()

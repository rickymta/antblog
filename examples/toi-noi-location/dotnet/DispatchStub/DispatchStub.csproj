<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ToiNoi.Location.DispatchStub</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0" PrivateAssets="All" />
    <!-- một hợp đồng duy nhất cho Rust, Go và C#: nhập thẳng file .proto của repo; matching.proto import routing.proto nên nhập cả hai -->
    <Protobuf Include="../../proto/location/v1/routing.proto" ProtoRoot="../../proto" GrpcServices="None" Link="Protos/routing.proto" />
    <Protobuf Include="../../proto/location/v1/matching.proto" ProtoRoot="../../proto" GrpcServices="Client" Link="Protos/matching.proto" />
  </ItemGroup>

</Project>

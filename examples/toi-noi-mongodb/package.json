{
  "name": "toi-noi-mongodb-lab",
  "private": true,
  "type": "module",
  "description": "Lab MongoDB 8.0 qua dự án Tới Nơi — MongoDB chạy trong Docker, mongosh chạy bên trong container; runner Node không có dependency",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "p01": "node run.mjs p01",
    "p01:output": "node run.mjs p01 > p01/OUTPUT.txt",
    "p01:rollback": "node run.mjs p01/06-migration-rollback.js",
    "p01:thu-nghiem": "node run.mjs p01/00-reset.js p01/thu-nghiem/mg004-kieu-bson.js",
    "test": "node --test \"test/*.test.mjs\""
  }
}

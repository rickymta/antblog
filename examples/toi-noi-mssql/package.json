{
  "name": "toi-noi-mssql-lab",
  "private": true,
  "type": "module",
  "description": "Lab SQL Server 2022 qua dự án Tới Nơi — SQL Server chạy trong Docker, sqlcmd chạy bên trong container; runner Node không có dependency",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "p01": "node run.mjs p01",
    "p01:output": "node run.mjs p01 > p01/OUTPUT.txt",
    "p01:rollback": "node run.mjs p01/06-migration-rollback.sql",
    "p01:thu-nghiem": "node run.mjs p01/00-reset.sql p01/thu-nghiem/ms004-kieu-du-lieu.sql",
    "test": "node --test \"test/*.test.mjs\""
  }
}

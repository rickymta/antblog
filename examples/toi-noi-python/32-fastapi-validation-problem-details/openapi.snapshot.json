{
  "openapi": "3.1.0",
  "info": {
    "title": "Tới Nơi - Báo giá",
    "description": "Bài 32: lỗi theo RFC 9457. Mô hình cước là giả định học tập.",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/quotes": {
      "post": {
        "tags": [
          "quotes"
        ],
        "summary": "Tạo báo giá",
        "operationId": "createQuote",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Yêu cầu sai hình dạng (thiếu trường, sai kiểu, trường lạ).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Lỗi nội bộ; chi tiết chỉ có trong log.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "Khoảng cách ngoài miền 0..100 km.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/quotes/{quote_id}": {
      "get": {
        "tags": [
          "quotes"
        ],
        "summary": "Đọc báo giá",
        "operationId": "getQuote",
        "parameters": [
          {
            "name": "quote_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Quote Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Yêu cầu sai hình dạng (thiếu trường, sai kiểu, trường lạ).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Lỗi nội bộ; chi tiết chỉ có trong log.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Không có báo giá với id này.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FieldProblem": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field",
            "examples": [
              "body.distance_km"
            ]
          },
          "code": {
            "type": "string",
            "title": "Code",
            "examples": [
              "decimal_max_places"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "code",
          "message"
        ],
        "title": "FieldProblem",
        "description": "Một lỗi theo trường. Client rẽ nhánh theo `code`, hiển thị `message`."
      },
      "ProblemDetails": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "default": "about:blank",
            "examples": [
              "https://toinoi.example/problems/distance-out-of-range"
            ]
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Tóm tắt ngắn, cố định theo `type`."
          },
          "status": {
            "type": "integer",
            "title": "Status",
            "description": "Mã HTTP, lặp lại cho tiện đọc từ body."
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail",
            "description": "Giải thích riêng cho lần lỗi này."
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance",
            "description": "Đường dẫn của request gây lỗi."
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldProblem"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors",
            "description": "Chỉ có ở lỗi validation."
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "title": "ProblemDetails",
        "description": "Đối tượng lỗi theo RFC 9457 (media type application/problem+json).\n\n`extra=\"allow\"` vì RFC cho phép thành viên mở rộng (ví dụ min_km, max_km)."
      },
      "QuoteRequest": {
        "properties": {
          "distance_km": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Distance Km",
            "description": "Khoảng cách km, tối đa 3 chữ số thập phân. Nên gửi dạng chuỗi.",
            "examples": [
              "2.5"
            ]
          },
          "service": {
            "$ref": "#/components/schemas/ServiceKind",
            "default": "ride"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "distance_km"
        ],
        "title": "QuoteRequest",
        "description": "Body của POST /v1/quotes. Chỉ kiểm hình dạng; miền 0..100 km là việc của miền (400)."
      },
      "QuoteResponse": {
        "properties": {
          "quote_id": {
            "type": "string",
            "title": "Quote Id",
            "examples": [
              "QT-0001"
            ]
          },
          "distance_km": {
            "type": "string",
            "title": "Distance Km"
          },
          "service": {
            "$ref": "#/components/schemas/ServiceKind"
          },
          "fare": {
            "type": "string",
            "title": "Fare",
            "description": "Cước VND, số nguyên dạng chuỗi.",
            "examples": [
              "14250"
            ]
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "VND"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At",
            "description": "UTC, hết hạn sau 5 phút."
          }
        },
        "type": "object",
        "required": [
          "quote_id",
          "distance_km",
          "service",
          "fare",
          "expires_at"
        ],
        "title": "QuoteResponse",
        "description": "Báo giá trả về. Decimal ra JSON là chuỗi (\"14250\"), không phải số thực."
      },
      "ServiceKind": {
        "type": "string",
        "enum": [
          "ride",
          "food",
          "parcel"
        ],
        "title": "ServiceKind"
      }
    }
  },
  "tags": [
    {
      "name": "quotes",
      "description": "Báo giá cước theo khoảng cách. Chưa tạo chuyến, chưa giữ tiền."
    }
  ]
}

{
  "components": {
    "schemas": {
      "FieldProblem": {
        "properties": {
          "code": {
            "examples": [
              "decimal_max_places"
            ],
            "title": "Code",
            "type": "string"
          },
          "field": {
            "examples": [
              "body.distance_km"
            ],
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "title": "FieldProblem",
        "type": "object"
      },
      "ProblemDetails": {
        "additionalProperties": true,
        "description": "`extra=\"allow\"` vì RFC cho phép thành viên mở rộng (min_km, max_km, request_id).",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldProblem"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Chỉ có ở lỗi validation.",
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "QuoteRequest": {
        "additionalProperties": false,
        "description": "Body của POST /v1/quotes. Chỉ kiểm hình dạng; miền 0..100 km là việc của miền (400).",
        "properties": {
          "distance_km": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "description": "Khoảng cách km, tối đa 3 chữ số thập phân. Nên gửi dạng chuỗi.",
            "examples": [
              "2.5"
            ],
            "title": "Distance Km"
          },
          "service": {
            "$ref": "#/components/schemas/ServiceKind",
            "default": "ride"
          }
        },
        "required": [
          "distance_km"
        ],
        "title": "QuoteRequest",
        "type": "object"
      },
      "QuoteResponse": {
        "description": "Báo giá trả về. Decimal ra JSON là chuỗi (\"14250\"), không phải số thực.",
        "properties": {
          "currency": {
            "default": "VND",
            "title": "Currency",
            "type": "string"
          },
          "distance_km": {
            "title": "Distance Km",
            "type": "string"
          },
          "expires_at": {
            "description": "UTC, hết hạn sau 5 phút.",
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "fare": {
            "description": "Cước VND, số nguyên dạng chuỗi.",
            "examples": [
              "14250"
            ],
            "title": "Fare",
            "type": "string"
          },
          "quote_id": {
            "examples": [
              "QT-0001"
            ],
            "title": "Quote Id",
            "type": "string"
          },
          "service": {
            "$ref": "#/components/schemas/ServiceKind"
          }
        },
        "required": [
          "quote_id",
          "distance_km",
          "service",
          "fare",
          "expires_at"
        ],
        "title": "QuoteResponse",
        "type": "object"
      },
      "ServiceKind": {
        "enum": [
          "ride",
          "food",
          "parcel"
        ],
        "title": "ServiceKind",
        "type": "string"
      },
      "TripOut": {
        "properties": {
          "customer_id": {
            "title": "Customer Id",
            "type": "string"
          },
          "distance_km": {
            "title": "Distance Km",
            "type": "string"
          },
          "driver_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Driver Id"
          },
          "service": {
            "$ref": "#/components/schemas/ServiceKind"
          },
          "status": {
            "$ref": "#/components/schemas/TripStatus"
          },
          "trip_id": {
            "title": "Trip Id",
            "type": "string"
          }
        },
        "required": [
          "trip_id",
          "customer_id",
          "driver_id",
          "service",
          "distance_km",
          "status"
        ],
        "title": "TripOut",
        "type": "object"
      },
      "TripStatus": {
        "enum": [
          "requested",
          "searching",
          "accepted",
          "arriving",
          "picked_up",
          "in_transit",
          "completed",
          "cancelled"
        ],
        "title": "TripStatus",
        "type": "string"
      }
    },
    "securitySchemes": {
      "OAuth2PasswordBearer": {
        "flows": {
          "password": {
            "scopes": {
              "customer": "Khách: báo giá, xem chuyến của mình",
              "dispatcher": "Điều phối: xem mọi chuyến, hủy chuyến",
              "driver": "Tài xế: xem chuyến được giao"
            },
            "tokenUrl": "/v1/auth/token"
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "title": "Tới Nơi · Quote & Trip API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/quotes": {
      "post": {
        "operationId": "createQuote",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Khoảng cách ngoài miền 0..100 km."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Thiếu hoặc sai token (kèm WWW-Authenticate: Bearer)."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Token đúng nhưng thiếu scope."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Yêu cầu sai hình dạng (thiếu trường, sai kiểu, trường lạ)."
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": [
              "customer"
            ]
          }
        ],
        "summary": "Create Quote"
      }
    },
    "/v1/quotes/{quote_id}": {
      "get": {
        "operationId": "getQuote",
        "parameters": [
          {
            "in": "path",
            "name": "quote_id",
            "required": true,
            "schema": {
              "title": "Quote Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Thiếu hoặc sai token (kèm WWW-Authenticate: Bearer)."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Token đúng nhưng thiếu scope."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Không có báo giá này, hoặc của khách khác."
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": [
              "customer"
            ]
          }
        ],
        "summary": "Get Quote"
      }
    },
    "/v1/trips/{trip_id}": {
      "get": {
        "description": "`Authenticated` chỉ đòi token hợp lệ, không đòi scope (không có 403 ở route này): quyền được quyết\nđịnh theo quan hệ giữa người gọi và chuyến, và mọi từ chối đều là 404.",
        "operationId": "getTrip",
        "parameters": [
          {
            "in": "path",
            "name": "trip_id",
            "required": true,
            "schema": {
              "title": "Trip Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Thiếu hoặc sai token (kèm WWW-Authenticate: Bearer)."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Không có chuyến, hoặc không phải chuyến của bạn."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Kho dữ liệu tạm thời không dùng được."
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Get Trip"
      }
    },
    "/v1/trips/{trip_id}/cancel": {
      "post": {
        "operationId": "cancelTrip",
        "parameters": [
          {
            "in": "path",
            "name": "trip_id",
            "required": true,
            "schema": {
              "title": "Trip Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Thiếu hoặc sai token (kèm WWW-Authenticate: Bearer)."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Token đúng nhưng thiếu scope."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Không có chuyến này."
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Trạng thái hiện tại không cho phép hủy."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Kho dữ liệu tạm thời không dùng được."
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": [
              "dispatcher"
            ]
          }
        ],
        "summary": "Cancel Trip"
      }
    }
  }
}

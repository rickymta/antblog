---
source: tests/openapi.rs
expression: reply.json()
---
{
  "components": {
    "schemas": {
      "BalanceResponse": {
        "description": "Kết quả `GET /v1/accounts/{id}/balance`.",
        "properties": {
          "account": {
            "description": "Mã tài khoản.",
            "type": "string"
          },
          "asOf": {
            "description": "Thời điểm đọc, RFC 3339 UTC.",
            "example": "2026-11-06T09:30:00Z",
            "type": "string"
          },
          "balanceDong": {
            "description": "Số dư đồng, có dấu.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "account",
          "balanceDong",
          "asOf"
        ],
        "type": "object"
      },
      "EntryResponse": {
        "description": "Kết quả ghi bút toán.",
        "properties": {
          "entryId": {
            "description": "Mã bút toán `JE-000001`.",
            "example": "JE-000001",
            "type": "string"
          },
          "idempotencyKey": {
            "description": "Khoá idempotency đã dùng.",
            "type": "string"
          },
          "postings": {
            "description": "Các dòng đã ghi, theo thứ tự gửi.",
            "items": {
              "$ref": "#/components/schemas/PostingDto"
            },
            "type": "array"
          },
          "replayed": {
            "description": "`true` nếu key đã có và nội dung trùng (HTTP 200); `false` khi vừa tạo (HTTP 201).",
            "type": "boolean"
          }
        },
        "required": [
          "entryId",
          "idempotencyKey",
          "replayed",
          "postings"
        ],
        "type": "object"
      },
      "FieldError": {
        "description": "Một lỗi theo trường, nằm trong thành phần mở rộng `errors`.",
        "properties": {
          "code": {
            "description": "Mã máy đọc được, ổn định: client rẽ nhánh theo mã này.",
            "example": "zero_amount",
            "type": "string"
          },
          "field": {
            "description": "Đường dẫn tới trường, ví dụ `postings[1].amountDong`.",
            "example": "postings[1].amountDong",
            "type": "string"
          },
          "message": {
            "description": "Câu mô tả cho người đọc.",
            "example": "số tiền phải khác 0",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "type": "object"
      },
      "PostEntryRequest": {
        "additionalProperties": false,
        "description": "Body của `POST /v1/entries`.",
        "properties": {
          "idempotencyKey": {
            "description": "Khoá idempotency của bút toán.",
            "example": "trip:TN-0001:capture",
            "type": "string"
          },
          "postings": {
            "description": "Ít nhất 2 dòng, tổng số tiền bằng 0.",
            "items": {
              "$ref": "#/components/schemas/PostingDto"
            },
            "type": "array"
          }
        },
        "required": [
          "idempotencyKey",
          "postings"
        ],
        "type": "object"
      },
      "PostingDto": {
        "additionalProperties": false,
        "description": "Một dòng bút toán trên dây: số tiền có dấu, dương là vào, âm là ra.",
        "properties": {
          "account": {
            "description": "Mã tài khoản, ví dụ `driver:DR-001`.",
            "example": "driver:DR-001",
            "type": "string"
          },
          "amountDong": {
            "description": "Số tiền đồng, có dấu, khác 0.",
            "example": 20400,
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "account",
          "amountDong"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "Problem Details của RFC 9457 kèm hai thành phần mở rộng: `errors` và `traceId`.",
        "properties": {
          "detail": {
            "description": "Giải thích riêng cho lần xảy ra này.",
            "example": "bút toán lệch, tổng bằng -5.100 VND",
            "type": "string"
          },
          "errors": {
            "description": "Mọi lỗi theo trường (chỉ có khi là lỗi validation).",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "instance": {
            "description": "Đường dẫn của request gây lỗi.",
            "example": "/v1/entries",
            "type": "string"
          },
          "status": {
            "description": "Mã HTTP, lặp lại trong body.",
            "example": 422,
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "description": "Tóm tắt ngắn, cùng một giá trị cho mọi lần xảy ra cùng loại lỗi.",
            "example": "Bút toán lệch",
            "type": "string"
          },
          "traceId": {
            "description": "Mã để tra log, sinh tại chỗ (32 hex, dạng W3C trace-id).",
            "example": "4bf92f3577b34da6a3ce929d0e0e4736",
            "type": "string"
          },
          "type": {
            "description": "URI định danh loại lỗi.",
            "example": "https://toi-noi.example/problems/unbalanced-entry",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "traceId"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "API sổ cái double-entry của Tới Nơi. Lỗi trả application/problem+json (RFC 9457).",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "title": "Tới Nơi Ledger API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/accounts/{id}/balance": {
      "get": {
        "operationId": "get_balance",
        "parameters": [
          {
            "description": "Mã tài khoản, ví dụ driver:DR-001",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalanceResponse"
                }
              }
            },
            "description": "Số dư hiện tại"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Mã tài khoản trên đường dẫn sai dạng"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Thiếu hoặc sai token"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Thiếu quyền ledger:read"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Tài khoản chưa tồn tại"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Đọc số dư một tài khoản.",
        "tags": [
          "ledger"
        ]
      }
    },
    "/v1/entries": {
      "post": {
        "operationId": "post_entry",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostEntryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryResponse"
                }
              }
            },
            "description": "Replay: key đã có, nội dung trùng"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryResponse"
                }
              }
            },
            "description": "Bút toán mới được ghi"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "JSON hỏng"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Thiếu hoặc sai token"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Thiếu quyền ledger:write"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Cùng key, khác nội dung"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Body vượt giới hạn 2 MB của axum"
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Không phải application/json"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bút toán lệch, thiếu dòng, sai hình dạng hoặc tài khoản chưa có"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Ghi một bút toán.",
        "tags": [
          "ledger"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Ghi bút toán và tra số dư",
      "name": "ledger"
    }
  ]
}

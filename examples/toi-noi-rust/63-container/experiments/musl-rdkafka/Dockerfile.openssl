# Bật feature ssl: cần thêm header và thư viện OpenSSL tĩnh, và OPENSSL_STATIC. Kỳ vọng THÀNH CÔNG.
FROM rust:1.98-alpine
RUN apk add --no-cache musl-dev make g++ perl python3 bash curl zlib-dev zlib-static openssl-dev openssl-libs-static pkgconf
ENV OPENSSL_STATIC=1
WORKDIR /app
COPY . .
RUN cargo build --release --locked --features ssl
